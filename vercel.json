    { "source": "/(.*)", "has": [{ "type": "host", "value": "axiombyrusan.vercel.app" }], "destination": "https://axiomsdigital.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "axiomsdigital.vercel.app" }], "destination": "https://axiomsdigital.com/$1", "permanent": true }
